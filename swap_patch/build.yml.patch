diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -1252,6 +1252,47 @@
             fi
           fi
 
+      - name: 关闭 swap（内核侧拒绝所有 swapon）
+        working-directory: ${{ env.KERNEL_ROOT }}/common
+        run: |
+          # 在 SYSCALL_DEFINE2(swapon) 入口直接返回 -EINVAL：任何 swapon 都会失败，
+          # 厂商 swapon_all（init.mt6991.rc + /vendor/etc/fstab.enableswap）因此失效。
+          swap_fail() {
+            if [ "$SKIP_INCOMPATIBLE" = "true" ]; then
+              echo "::warning title=关闭 swap 已跳过::$1"
+              if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
+                echo "" >> "$GITHUB_STEP_SUMMARY"
+                echo ">  **关闭 swap** 已自动跳过：$1（构建未中断）" >> "$GITHUB_STEP_SUMMARY"
+              fi
+              exit 0
+            fi
+            echo "::error::$1"
+            exit 1
+          }
+
+          SWAP_PATCH="$ZZH_PATCHES/swap_patch/refuse_all_swap.patch"
+          if [ ! -f "$SWAP_PATCH" ]; then
+            swap_fail "未找到补丁文件 swap_patch/refuse_all_swap.patch"
+          fi
+
+          # 幂等：已含改动则跳过
+          if grep -q "refuse all swap" mm/swapfile.c; then
+            echo "mm/swapfile.c 已含关闭 swap 改动，跳过"
+            exit 0
+          fi
+
+          if git apply --check -p1 "$SWAP_PATCH" >/dev/null 2>&1; then
+            git apply -p1 "$SWAP_PATCH"
+          elif patch -p1 --forward --batch < "$SWAP_PATCH" >/dev/null 2>&1; then
+            echo "已通过 patch 应用"
+          else
+            swap_fail "mm/swapfile.c 补丁未应用（内核版本不匹配）"
+          fi
+
+          if ! grep -q "refuse all swap" mm/swapfile.c; then
+            swap_fail "补丁应用后校验失败"
+          fi
+          echo "swapon 已改为直接返回 -EINVAL，swap 不会再被启用"
       - name: 添加 BBG 基带保护补丁
         if: inputs.use_bbg
         working-directory: ${{ env.KERNEL_ROOT }}
