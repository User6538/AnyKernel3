diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -1293,6 +1293,48 @@
             swap_fail "补丁应用后校验失败"
           fi
           echo "swapon 已改为直接返回 -EINVAL，swap 不会再被启用"
+      - name: 忽略 zcache prio 写入（规避厂商模块越界重启）
+        working-directory: ${{ env.KERNEL_ROOT }}/common
+        run: |
+          # /sys/zcache/prio 的写入会进厂商 zcache 模块的 prio_store；启动早期其线程/池表
+          # 尚未初始化完成时会数组越界，配合 CONFIG_UBSAN_TRAP=y 直接导致整机重启。
+          # 这里在 sysfs 写入入口忽略该节点的写入（吞掉、不拒绝），避免触发该路径。
+          prio_fail() {
+            if [ "$SKIP_INCOMPATIBLE" = "true" ]; then
+              echo "::warning title=忽略 zcache prio 写入已跳过::$1"
+              if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
+                echo "" >> "$GITHUB_STEP_SUMMARY"
+                echo "> ⏭️ **忽略 zcache prio 写入** 已自动跳过：$1（构建未中断）" >> "$GITHUB_STEP_SUMMARY"
+              fi
+              exit 0
+            fi
+            echo "::error::$1"
+            exit 1
+          }
+
+          PRIO_PATCH="$ZZH_PATCHES/prio_patch/ignore_zcache_prio.patch"
+          if [ ! -f "$PRIO_PATCH" ]; then
+            prio_fail "未找到补丁文件 prio_patch/ignore_zcache_prio.patch"
+          fi
+
+          # 幂等：已含改动则跳过
+          if grep -q "ZCACHE_PRIO_WRITE_IGNORE" fs/sysfs/file.c; then
+            echo "fs/sysfs/file.c 已含忽略写入改动，跳过"
+            exit 0
+          fi
+
+          if git apply --check -p1 "$PRIO_PATCH" >/dev/null 2>&1; then
+            git apply -p1 "$PRIO_PATCH"
+          elif patch -p1 --forward --batch < "$PRIO_PATCH" >/dev/null 2>&1; then
+            echo "已通过 patch 应用"
+          else
+            prio_fail "fs/sysfs/file.c 补丁未应用（内核版本不匹配）"
+          fi
+
+          if ! grep -q "ZCACHE_PRIO_WRITE_IGNORE" fs/sysfs/file.c; then
+            prio_fail "补丁应用后校验失败"
+          fi
+          echo "已在 sysfs 写入入口忽略 /sys/zcache/prio 的写入"
       - name: 添加 BBG 基带保护补丁
         if: inputs.use_bbg
         working-directory: ${{ env.KERNEL_ROOT }}
