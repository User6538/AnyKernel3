diff --git a/fs/sysfs/file.c b/fs/sysfs/file.c
--- a/fs/sysfs/file.c
+++ b/fs/sysfs/file.c
@@ -133,6 +133,18 @@
 	if (!count)
 		return 0;
 
+	/*
+	 * ZCACHE_PRIO_WRITE_IGNORE: 厂商 zcache 模块在启动早期处理
+	 * /sys/zcache/prio 的写入时，会在其线程/池表尚未初始化完成的情况下越界
+	 * （prio_store -> alloc_io_context -> ___slab_alloc），配合 CONFIG_UBSAN_TRAP=y
+	 * 会直接导致整机 panic 重启。这里在 sysfs 写入入口精确匹配该节点并忽略本次写入
+	 * （按已写入长度返回，不调用底层 store）；读路径与其它 sysfs 属性不受影响。
+	 */
+	if (of->kn && of->kn->parent &&
+	    !strcmp(of->kn->name, "prio") &&
+	    !strcmp(of->kn->parent->name, "zcache"))
+		return count;
+
 	return ops->store(kobj, of->kn->priv, buf, count);
 }
 
